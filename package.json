{
  "name": "manageable-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Windows-first local MCP proxy with lazy discovery, groups, prompts, OAuth, policy, health, CLI, and admin.",
  "type": "module",
  "bin": {
    "manageable-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "test:e2e": "node scripts/e2e-local.mjs",
    "demo:http": "node dist/index.js serve --config servers.example.json --transport http"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "happy-dom": "^21.0.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.0"
  }
}
